{
  "name": "@step-security/setup-toolchain",
  "version": "0.6.4",
  "description": "A GitHub action to setup and cache the proto and moon toolchains.",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build ./index.ts && ncc build ./post.ts --out ./dist/post",
    "check": "npm run lint && npm run test && npm run typecheck",
    "lint": "eslint --fix .",
    "test": "echo 'Not yet'",
    "test:input": "ts-node ./index.ts",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/step-security/moonrepo-setup-toolchain.git"
  },
  "author": "step-security",
  "license": "MIT",
  "dependencies": {
    "@actions/cache": "^5.0.5",
    "@actions/core": "^2.0.3",
    "@actions/glob": "^0.5.1",
    "@actions/tool-cache": "^3.0.1",
    "axios": "^1.18.1",
    "execa": "^5.1.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@vercel/ncc": "^0.38.3",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-n": "^17.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.6.2",
    "prettier-config-moon": "^1.2.1",
    "ts-node": "^10.9.2",
    "tsconfig-moon": "^1.4.1",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
